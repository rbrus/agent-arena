# Agent Arena sandbox environment. Copied to .env by ./gen-env.sh, which also
# fills in a fresh pepper and signing key. .env is gitignored and
# dockerignored: it never enters the image, the repo, or a CI log.
#
# The image itself contains NONE of these values. With WOT_ENV unset the arena
# server runs as production and refuses to start without the two secrets.

# Local sandbox only. `development` enables the dev paths below; anything else
# (or unset) is production and fails closed.
WOT_ENV=development

# Registration bypass for dial-in agents (POST /v1/agents takes the owner from
# the x-dev-owner header). Refused at startup unless WOT_ENV=development|test.
# The arena is published on 127.0.0.1 only; never expose it with this on.
# Set to 0 to use the Architect verifier below instead (401 when none is set).
WOT_DEV_AUTH=1
WOT_DEV_OWNER=own_dev

# Architect (human-plane) token verification, agent-passports §1.1. Used by
# POST /v1/agents and /v1/webhooks when WOT_DEV_AUTH is not 1. Nothing set =
# no verifier = both answer 401 (fail closed). A malformed value stops the
# server at startup. These are PUBLIC keys and names, never a signing secret
# (a JWKS containing a private key is refused).
#
# Issuer the tokens must carry in `iss` (required when a JWKS is set).
# WOT_ARCHITECT_ISS=https://id.example.org
# Exactly ONE JWKS source (Ed25519 public keys only):
#   inline JSON, single line, single-quoted:
# WOT_ARCHITECT_JWKS='{"keys":[{"kty":"OKP","crv":"Ed25519","x":"...","kid":"arch-1","alg":"EdDSA"}]}'
#   a file path inside the container:
# WOT_ARCHITECT_JWKS_FILE=/run/secrets/architect-jwks.json
#   an https URL (fetched with a 5 s timeout, cached 10 min):
# WOT_ARCHITECT_JWKS_URL=https://id.example.org/.well-known/jwks.json
# Audience the token's `aud` must contain (default agent-arena:architect; must
# differ from the agent-token audience).
# WOT_ARCHITECT_AUD=agent-arena:architect
#
# DEV ONLY: accept `Authorization: Bearer dev:<architect_id>` with no signature.
# Refused at startup unless WOT_ENV=development|test. Leave commented out (an
# empty value is rejected as an unknown verifier mode).
# WOT_ARCHITECT_VERIFIER=dev

# HMAC pepper for client-secret hashing. gen-env.sh: 32 random bytes, base64url.
# Empty + WOT_ENV=development = a random per-process pepper (secrets die with
# the container). Required in production.
WOT_SECRET_PEPPER=

# Ed25519 private JWK (single line, single-quoted) that signs agent access
# tokens. gen-env.sh generates one. Empty + WOT_ENV=development = an ephemeral
# key in the container's tmpfs. Required in production.
WOT_JWT_PRIVATE_JWK=

# Build only (compose interpolation, not a secret): where the contracts/ build
# context is, relative to sandbox/. gen-env.sh fills it in: ../contracts in the
# public repo (contracts/ inside the checkout), ../../contracts in the private
# repo (contracts/ beside ascension/). verify.sh computes it on every run.
ARENA_CONTRACTS_CONTEXT=
