{
  "name": "ascension",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Agent Arena npm workspace: the engine, scenarios, report writer, contracts bindings and the CLI. Run via tsx, no build step.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "codegen": "node packages/wot-contracts/codegen.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p sandbox/tsconfig.json && tsc --noEmit -p agents/tsconfig.json",
    "test": "WOT_ENV=test node --test --import tsx packages/*/test/*.test.ts",
    "contracts:tier0": "node .github/scripts/contract-selfcheck.mjs",
    "contracts:check": "node .github/scripts/contract-check.mjs",
    "sarif:validate": "tsx packages/arena-report/scripts/sarif-validate.ts",
    "check": "npm run codegen && npm run typecheck && npm test && npm run contracts:tier0 && npm run contracts:check",
    "build:cli": "tsx packages/arena-cli/build.ts",
    "target:reference": "tsx packages/arena-cli/src/bin.ts serve-reference",
    "licenses:third-party": "node packages/arena-cli/scripts/licenses.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbrus/agent-arena.git"
  },
  "homepage": "https://github.com/rbrus/agent-arena#readme",
  "bugs": {
    "url": "https://github.com/rbrus/agent-arena/issues"
  }
}
