  {
   "id": "6.A.5",
   "title": "Move to own sector with convoy",
   "status": "standard",
   "rules": [
    "4.E.1"
   ],
   "requires": [
    "movement"
   ],
   "transcription_notes": "The DATC gives Germany a fleet in London; transcribed as written.",
   "setup": {
    "phase": "S1901M",
    "units": [
     { "power": "england", "type": "F", "at": "nth" },
     { "power": "england", "type": "A", "at": "yor" },
     { "power": "england", "type": "A", "at": "lvp" },
     { "power": "germany", "type": "F", "at": "lon" },
     { "power": "germany", "type": "A", "at": "wal" }
    ]
   },
   "steps": [
    {
     "orders": {
      "england": [
       { "o": "F nth C A yor - yor", "result": "illegal", "reason": "convoy_bad_destination" },
       { "o": "A yor - yor", "result": "illegal", "reason": "move_to_self" },
       { "o": "A lvp S A yor - yor", "result": "illegal", "reason": "unsupportable_move" }
      ],
      "germany": [
       { "o": "F lon - yor", "result": "success" },
       { "o": "A wal S F lon - yor", "result": "success" }
      ]
     },
     "expect": {
      "units_after": [
       { "power": "england", "type": "F", "at": "nth" },
       { "power": "england", "type": "A", "at": "lvp" },
       { "power": "germany", "type": "F", "at": "yor" },
       { "power": "germany", "type": "A", "at": "wal" }
      ],
      "dislodged_after": [
       { "power": "england", "type": "A", "at": "yor" }
      ]
     }
    }
   ]
  },
