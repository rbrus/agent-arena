{
  "name": "wot-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated wire types + AJV validators for the Agent Arena contracts. Single source: ../../contracts/schemas.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/frames": "./src/generated/frames.ts",
    "./contracts-dir": "./src/contracts-dir.ts"
  },
  "scripts": {
    "codegen": "node codegen.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0"
  }
}
