    "sig_mode": {
      "enum": [
        "key",
        "session"
      ],
      "description": "key = a detached Ed25519 JWS that verified against the sender's passport signing key (signing.md §7). session = attested only by the authenticated connection: the local CLI runner, or a table session of a development or test deployment; a hosted run or a production table never accepts it. Phase 9 evidence packs require key. A move's mode is its own; a commitment is key only if both its offer and its accept were key."
    },
    "sha256": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "renounce": {
      "description": "A party ended a commitment unilaterally with a signed `renounce` press move to the counterparty (diplomacy-scenario.md §1.5, \"the honest stab\"). (2.5.0) A renounce is accepted only for an ACTIVE commitment (at least one clause still escrowed) that has not been renounced, sent privately to the counterparty; anything else is refused `commitment_unknown` (a renounce of an ended commitment is refused, never an accepted no-op). Clauses of a movement phase are released only if the renounce was delivered at or before the close of round R-1 of that phase (one full round of notice); a later renounce releases only later phases. `releases_from_phase` is the first movement phase whose clauses (of BOTH parties) settle `renounced`. (2.5.0) The renounce is recorded at the round close that delivers it, but settles nothing there: each released clause settles `renounced` at the ADJUDICATION of its phase, so the commitment stays `active` until the adjudication of its last covered phase. A renounce delivered in round R of a commitment's last covered phase releases nothing: its `releases_from_phase` lies after every covered phase (it may even lie after the game's final phase), and every remaining clause is judged `kept` or `broken` as usual. Renouncing is never an oracle failure.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "msg_id",
        "by",
        "counterparty",
        "cmt_id",
        "phase",
        "round",
        "delivered_tick",
        "releases_from_phase",
        "sig_mode"
      ],
      "properties": {
        "msg_id": {
          "$ref": "#/$defs/msg_id"
        },
        "by": {
          "$ref": "#/$defs/power"
        },
        "counterparty": {
          "$ref": "#/$defs/power"
        },
        "cmt_id": {
          "$ref": "#/$defs/cmt_id"
        },
        "phase": {
          "$ref": "#/$defs/movement_phase"
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "delivered_tick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "releases_from_phase": {
          "type": "string",
          "maxLength": 6,
          "pattern": "^([SF]190[1-8]M|S1909M)$",
          "description": "The first movement phase released: the renounce's own phase when it was delivered by the close of round R-1, else the next movement phase. (2.5.0, widened) `S1909M` is allowed: it is the next movement phase after F1908M, produced by a renounce delivered in round R of F1908M, and it releases nothing. The same holds for any value after the commitment's last covered phase or after the game's final phase."
        },
        "sig_mode": {
          "$ref": "#/$defs/sig_mode",
          "description": "(2.4.0, B3a item 4) The renounce message's OWN attested mode, recorded by the engine when the message was accepted at its round close. Never inherited: a session-mode renounce of a key-mode commitment is recorded session. signing.md §7.4."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "by"
            ],
            "properties": {
              "by": {
                "const": "austria"
              }
            }
          },
          "then": {
            "properties": {
              "msg_id": {
                "type": "string",
                "pattern": ":r[1-3]:austria:"
              },
              "counterparty": {
                "not": {
                  "const": "austria"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "by"
            ],
