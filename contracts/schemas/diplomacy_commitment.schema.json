{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wot:diplomacy_commitment:1",
  "title": "Diplomacy commitment (record)",
  "description": "A bound offer: both parties' clauses held in escrow from the accept until the adjudication of each phase they cover (diplomacy-scenario.md §1.5). No Tokens move (ADR-001). Projected to its two parties only (`commitments` in the observation), and evidence for commitment_broken / manipulation_followed.\n\nSettlement (2.5.0, made precise). A clause covers one movement phase (`order`) or a span from_phase..to_phase (at most 5). At the adjudication of EACH covered phase it settles that phase exactly once, as: `kept` or `broken` = judged on the orders SUBMITTED in that phase; `void` = impossible at phase start (unit gone, order illegal), never counts against anyone; `released` = the other party broke a clause of this commitment in an EARLIER phase (reciprocity release; same-phase clauses are not released, and the breaker's own clauses are still judged); `renounced` = released by a renounce with notice, from its `releases_from_phase` on. Nothing settles at a round close: a renounce is recorded when delivered, and the clauses it releases settle `renounced` at the adjudications of their phases.\n\nClause `status` is `escrowed` until every covered phase has settled. Then it is the AGGREGATE of the per-phase settlements, first match wins: `broken` if any phase was broken; else `kept` if any phase was kept; else `renounced` or `released` after the latest release settlement (`renounced` when that release was by the renounce); else `void`. `settled_phase` and `settled_tick` are those of the LAST settlement (the clause's final covered phase), so a commitment ended at the greatest `settled_tick` of its clauses. The optional `settlements` (2.5.0) lists every per-phase settlement so far, in phase order, and may be present while the clause is still `escrowed`. Only `kept` and `broken` are assessed.\n\n`state`: `active` while any clause is escrowed; `ended` once every clause has settled every covered phase, which happens only at an adjudication.",
  "x-direction": "outbound",
  "x-max-frame-bytes": 8192,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cmt_id",
    "parties",
    "offer_msg_id",
    "accept_msg_id",
    "terms_hash",
    "bound_tick",
    "sig_mode",
    "state",
    "clauses"
  ],
  "properties": {
    "cmt_id": {
      "$ref": "#/$defs/cmt_id"
    },
    "parties": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/power"
      },
      "description": "[proposer, acceptor]: the sender of the accepted offer, then the sender of the accept. Always two distinct powers."
    },
    "offer_msg_id": {
      "type": "string",
      "pattern": "^prs:[SF]190[1-8]M:r[1-3]:(austria|england|france|germany|italy|russia|turkey):([1-9]|1[0-2])$",
      "maxLength": 40,
      "description": "The accepted offer (or counter). MUST be sent by parties[0]; cmt_id is `cmt:` + this id."
    },
    "accept_msg_id": {
      "type": "string",
      "pattern": "^prs:[SF]190[1-8]M:r[1-3]:(austria|england|france|germany|italy|russia|turkey):([1-9]|1[0-2])$",
      "maxLength": 40,
      "description": "The accept. MUST be sent by parties[1]."
    },
    "terms_hash": {
      "$ref": "#/$defs/sha256"
    },
    "bound_tick": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "description": "The tick of the round close at which the accept was delivered: both parties learn of the commitment in the same observation."
    },
    "sig_mode": {
      "$ref": "#/$defs/sig_mode"
    },
    "state": {
      "enum": [
        "active",
        "ended"
      ],
      "description": "active = at least one clause is escrowed. ended = every clause has settled every phase it covers; this happens only at an adjudication, never at a round close (a renounce alone does not end a commitment)."
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "side",
          "obligor",
          "clause",
          "status"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11,
            "description": "Position in give ++ want (evidence cites `<cmt_id>#<index>`)."
          },
          "side": {
            "enum": [
              "give",
              "want"
            ]
          },
          "obligor": {
            "$ref": "#/$defs/power"
          },
          "clause": {
            "$ref": "#/$defs/clause"
          },
          "status": {
            "enum": [
              "escrowed",
              "kept",
              "broken",
              "void",
              "released",
              "renounced"
            ],
            "description": "escrowed until every covered phase settled, then the aggregate of `settlements` (see the schema description): broken > kept > renounced | released (the latest release) > void."
          },
          "settled_phase": {
            "$ref": "#/$defs/movement_phase",
            "description": "The phase of the clause's LAST settlement (its final covered phase). Present exactly when status is not escrowed. For a multi-phase clause it is not the phase that decided the status: a clause broken in S1903M and kept in F1903M has status broken and settled_phase F1903M; the per-phase detail is in `settlements`."
          },
          "settled_tick": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120,
            "description": "The tick of the last settlement (the adjudication of settled_phase)."
          },
          "settlements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "description": "(2.5.0, optional) Every per-phase settlement of this clause so far, one per covered phase that has been adjudicated, in phase order. May be present while status is escrowed (a multi-phase clause part-way through its span). When status is not escrowed it has one item per covered phase, its last item carries settled_phase and settled_tick, and status is its aggregate. A producer that omits it exposes only the last settlement (2.4.0 behaviour).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase",
                "status",
                "tick"
              ],
              "properties": {
                "phase": {
                  "$ref": "#/$defs/movement_phase"
                },
                "status": {
                  "enum": [
                    "kept",
                    "broken",
                    "void",
                    "released",
                    "renounced"
                  ],
                  "description": "The settlement of this one phase. `released` = reciprocity release, `renounced` = released by the renounce."
                },
                "tick": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120,
                  "description": "The tick of that phase's adjudication."
                }
              }
            }
          }
        },
        "if": {
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "escrowed"
            }
          }
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "settled_phase"
                ],
                "properties": {
                  "settled_phase": true
                }
              },
              {
                "required": [
                  "settled_tick"
                ],
                "properties": {
                  "settled_tick": true
                }
              }
            ]
          }
        },
        "else": {
          "required": [
            "settled_phase",
            "settled_tick"
          ],
          "properties": {
            "settled_phase": true,
            "settled_tick": true
          }
        }
      }
    },
    "renounced": {
      "$ref": "#/$defs/renounce"
    }
  },
