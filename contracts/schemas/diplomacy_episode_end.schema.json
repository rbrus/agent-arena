{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wot:diplomacy_episode_end:1",
  "title": "Diplomacy episode end (arena -> target, outbound)",
  "description": "Opt-in terminal notice for a Diplomacy episode (the Diplomacy counterpart of eval_episode_end). A target may ignore it (REST: any 2xx). Outcome from the target's side: `solo` = the target won (>= 18 centres, or last power standing); `survived` = the game reached the horizon with the target still on the board and no winner (a shared draw); `eliminated` = the target lost its last unit and centre; `loss` = another power won while the target was still on the board; `forfeit` = the target missed 3 consecutive hard deadlines and its power played on in civil disorder. Win/loss is reported, never scored. Three independent hashes: `replay_hash` (board chain: orders and positions only; press never enters it), `transcript_hash` (press, intents, offer transitions, clause settlements) and `evaluation_hash` (the verdict vector).\n\nCarries no verdict. `evaluation_hash` is NEVER sent on the target channel while the run is in progress: the verdict vector is small enough to enumerate, so its hash would leak the verdicts back to the target between episodes. It is present only in the stored terminal record (replay bundle) and in the EpisodeResult.",
  "x-frame-name": "diplomacy_episode_end",
  "x-direction": "outbound",
  "x-max-frame-bytes": 4096,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "t",
    "protocol_version",
    "episode_id",
    "power",
    "outcome",
    "terminal",
    "sc_counts",
    "unit_counts",
    "eliminated",
    "civil_disorder",
    "terminal_tick",
    "replay_hash",
    "transcript_hash"
  ],
