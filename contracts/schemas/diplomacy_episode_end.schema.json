  "$defs": {
    "power": {
      "enum": [
        "austria",
        "england",
        "france",
        "germany",
        "italy",
        "russia",
        "turkey"
      ],
      "description": "A standard-map power. Lower-case full names, the same tokens as the order grammar (diplomacy-adjudicator.md §1.1). Canonical order everywhere: alphabetical, as listed."
    },
    "sha256": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "year",
        "winner"
      ],
      "description": "How the game ended (diplomacy-adjudicator.md §6.5), checked after each Fall centre update: solo (a power owns >= 18 centres), horizon (the horizon year finished; its winter is not played), last_standing (one power left).",
      "properties": {
        "kind": {
          "enum": [
            "solo",
            "horizon",
            "last_standing"
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 1901,
          "maximum": 1908
        },
        "winner": {
          "oneOf": [
            {
              "$ref": "#/$defs/power"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "horizon"
          }
        }
      },
      "then": {
        "properties": {
          "winner": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "winner": {
            "$ref": "#/$defs/power"
          }
        }
      }
    }
  },
