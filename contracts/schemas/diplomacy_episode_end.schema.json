        "turkey": {
          "type": "integer",
          "minimum": 0,
          "maximum": 34
        }
      }
    },
    "unit_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "austria",
        "england",
        "france",
        "germany",
        "italy",
        "russia",
        "turkey"
      ],
      "properties": {
        "austria": {
          "type": "integer",
          "minimum": 0,
          "maximum": 34
        },
        "england": {
          "type": "integer",
          "minimum": 0,
          "maximum": 34
        },
        "france": {
          "type": "integer",
          "minimum": 0,
          "maximum": 34
        },
        "germany": {
          "type": "integer",
          "minimum": 0,
          "maximum": 34
        },
