{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wot:spectator_match_end:1",
  "title": "Spectator match-end frame (server -> spectator, outbound)",
  "description": "Terminal frame on the broadcast channel: the match is over. Public analogue of the player `match_end` (no `you`/`result` — a spectator is not a player). Carries the outcome, the now-revealed seed, and the hash-committed replay pointer so the viewer can hand off to the replay/scrub client (GET /v1/replays/{replay_id}). Immediately followed by a normal WSS close (code 1000).",
  "x-frame-name": "spectator_match_end",
  "x-direction": "outbound",
  "x-max-frame-bytes": 4096,
  "type": "object",
  "additionalProperties": false,
  "required": ["t", "protocol_version", "match_id", "winner", "reason", "final_scores", "ticks_played", "seed", "replay_id", "replay_hash", "players"],
  "properties": {
    "t": { "const": "spectator_match_end" },
    "protocol_version": { "const": "1.0" },
    "match_id": { "type": "string", "pattern": "^mat_[0-9A-HJKMNP-TV-Z]{26}$" },
    "winner": { "enum": ["A", "B", "draw"] },
    "reason": { "enum": ["ascension", "elimination", "timeout", "forfeit"] },
    "forfeit_reason": { "enum": ["connection_lost", "disqualified", "abandoned"], "description": "Present only when reason=forfeit." },
    "tiebreak": { "enum": ["score", "surviving_hp", "tokens_spent", "draw"], "description": "Present only when reason=timeout: the rung of the deterministic tiebreak ladder that decided it." },
    "final_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": { "A": { "type": "integer", "minimum": 0 }, "B": { "type": "integer", "minimum": 0 } }
    },
    "tokens_remaining": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B"],
      "properties": { "A": { "type": "integer", "minimum": 0 }, "B": { "type": "integer", "minimum": 0 } }
    },
    "ticks_played": { "type": "integer", "minimum": 0 },
    "seed": { "type": "integer", "description": "Revealed at match end; with the replay it makes the whole match bit-for-bit reproducible." },
    "replay_id": { "type": "string", "pattern": "^rpl_[0-9A-HJKMNP-TV-Z]{26}$" },
    "replay_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "players": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["player_id", "agent_id", "display_name", "result"],
        "properties": {
          "player_id": { "enum": ["A", "B"] },
          "agent_id": { "type": "string", "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$" },
          "display_name": { "type": "string", "maxLength": 32 },
          "result": { "enum": ["win", "loss", "draw"] }
        }
      }
    }
  },
  "examples": [
    {
      "t": "spectator_match_end",
      "protocol_version": "1.0",
      "match_id": "mat_01J8ZK9QMR4T7V2X0PABCDE3FG",
      "winner": "A",
      "reason": "ascension",
      "final_scores": { "A": 100, "B": 71 },
      "tokens_remaining": { "A": 88, "B": 0 },
      "ticks_played": 73,
      "seed": 2864901733,
      "replay_id": "rpl_01J8ZKB3T9W5Q2Y7N0MHDEF4GX",
      "replay_hash": "sha256:9f2c1b7e4a6d8035f1c2b3a4d5e6f7089a0b1c2d3e4f5061728394a5b6c7d8e9",
      "players": [
        { "player_id": "A", "agent_id": "agt_01J8ZK9QMR4T7V2X0PABCDE3FG", "display_name": "Reflex Prime", "result": "win" },
        { "player_id": "B", "agent_id": "agt_RR33N2WP4JDB6SXCKN87CKTSV6", "display_name": "House Bot (Bronze)", "result": "loss" }
      ]
    }
  ]
}
