{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wot:evidence_input:1",
  "title": "Evidence renderer inputs (agent-arena evidence --inputs, render/input.json)",
  "description": "(2.13.0) The seal step's own facts that the evidence renderer needs and the signed report does not carry: the document `agent-arena evidence --inputs <path>` reads (HOSTED-PROFILE §2.7 step 6, signing.md §5.3 step 4). The Sixi seal step writes it to `runs/<id>/render/input.json` before it starts the keyless evidence job. Nothing else the evidence states comes from this document: seal time, region, organisation, origin, image digest, engine build and key id are read from the signed `report.json` only, and the packs from the mounted pack envelopes. A document that fails this schema, is over `x-max-frame-bytes`, is not UTF-8 JSON, or names another `run_id` than the sealed report is refused with `input_invalid` (errors.md §1d, exit 2) and nothing is written. Unknown members are refused at every level (`additionalProperties: false`), so a seal-side fact the report already carries (for example `sealed_at`) cannot be supplied here; `crosscheck_record` is closed by its own schema. A new member is a contract MINOR. The document carries no key and no target credential.",
  "x-direction": "inbound",
  "x-max-frame-bytes": 8388608,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_version",
    "run_id",
    "jwks_url",
    "admission"
  ],
  "properties": {
    "input_version": {
      "const": "1.0",
      "description": "The input format. `1.0` is the only value; another value is refused (`input_invalid`)."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f]*$",
      "description": "The run the evidence is rendered for. MUST equal the sealed report's `run.run_id`; a document for another run is refused (`input_invalid`). No C0 control character."
    },
    "jwks_url": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^https://[^\\s?#]+$",
      "description": "The published report key set a reader fetches to verify the signatures the evidence names (`evidence_report` `signature.jwks_url`). https only, no whitespace, no query, no fragment. The renderer never fetches it."
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reports_until",
        "audit_until"
      ],
      "description": "From the control plane's admission record (EVIDENCE-REPORT-TEMPLATE Appendix B): the retention dates and, when known, who asked for the run and an incident reference.",
      "properties": {
        "reports_until": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "When the report, the SARIF and their signatures are deleted (the run's report horizon). RFC 3339."
        },
        "audit_until": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "When the audit record of the run (no content) is deleted. RFC 3339."
        },
        "credential_destroyed_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64,
          "description": "When the run-scoped target credential was destroyed (HOSTED-PROFILE §2.5). Absent: the evidence says \"destroyed at the end of the run\". RFC 3339."
        },
        "requested_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor_kind",
            "actor_id"
          ],
          "description": "Who admitted the run, as an opaque actor id. Never a name or an e-mail address.",
          "properties": {
            "actor_kind": {
              "enum": [
                "user",
                "pipeline_token",
                "system"
              ]
            },
            "actor_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{3,63}$",
              "description": "Opaque id, 4 to 64 characters; the pattern admits no `@`, `.` or space."
            }
          }
        },
        "incident_ref": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "description": "The incident a reproducibility cross-check failure after the seal opened, shown in the evidence notice."
        }
      }
    },
    "crosscheck_record": {
      "type": "object",
      "description": "Optional. The signed cross-check record for the run's image digest (`wot:crosscheck_record:1`, CROSSCHECK.md). Its content is closed by `crosscheck_record.schema.json`, which the consumer applies to this member (this schema does not reference across files), and its embedded signature MUST verify with the same report key set as the sealed report, at its `finished_at` (signing.md §5.2 E4). A record that fails its schema is `input_invalid`; one whose signature does not verify is `signature_invalid`; a verified record for another image digest or engine build is refused by the renderer (`renderer_refused`, code `input`). Absent: the renderer withholds `evidence.json` and the command exits 1 with `evidence.md` only."
    },
    "corpus": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "maxLength": 128
      },
      "description": "Optional. The `sixi-assure-rules` corpus snapshot, keyed by clause id (`REGIME:DOC:REF`, at most 128 characters; the renderer refuses a key outside its clause-id grammar with `renderer_refused`, code `input`). Required for `evidence.json` when the run mounts a pack (EVIDENCE-REPORT-TEMPLATE R4); without it the renderer withholds `evidence.json`.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrument",
          "reference",
          "paraphrase",
          "url"
        ],
        "properties": {
          "instrument": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The instrument, e.g. \"Regulation (EU) 2024/1689 (AI Act)\"."
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "The reference inside the instrument, e.g. \"Art. 14\"."
          },
          "paraphrase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Sixi's own paraphrase, never the source's wording."
          },
          "url": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^https://",
            "description": "The official source (https)."
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "description": "The clause heading, when the record has one."
          }
        }
      }
    }
  },
