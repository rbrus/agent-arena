{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wot:pack_manifest:1",
  "title": "Sixi Arena scenario pack manifest (pack.yaml)",
  "description": "(2.2.0, K9) The manifest of a closed Sixi Arena scenario pack (HOSTED-PROFILE §5). A pack crosses a trust boundary into the hosted runner and the evidence builder, so the parsed `pack.yaml` MUST validate against this schema (and its DSSE envelope, payload type `application/vnd.sixi.arena-pack+json`, MUST verify against the pinned control-plane key set; signing.md §11, 2.6.0) before anything in it is used. Kinds: clause_map (open oracle ids to corpus clause ids), scenario_variant (data-only `sx_` scenarios over an open module), adversarial_peer (LLM-driven peer seats, recorded inputs per K7). Load rules beyond the schema: the run's engine build MUST be in `engine.builds` (else `pack_engine_mismatch`); every clause id MUST resolve in the corpus at `corpus.ref`; (2.9.0) every clause id cited by `oracles[]` or `rules[]` MUST be in `coverage.clauses`; every rule's fixtures MUST pass the pack eval; only packs the org is entitled to are mounted. A pack never adds or renames an oracle id or a SARIF rule id, and never changes a level. (2.6.0) Packaging: the manifest, as JSON, is the payload of `pack.dsse.json` in the pack directory `$ARENA_PACKS_DIR/<id>/`; a `scenario_variant` entry's `data` file is an `arena-pack-variant/1` document (`pack_variant.schema.json`). Caps: envelope 524288 bytes, payload `x-max-frame-bytes`, variant file 65536 bytes.",
  "x-direction": "inbound",
  "x-max-frame-bytes": 262144,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "version",
    "kinds",
    "title",
    "licence",
    "engine",
    "corpus",
    "regimes",
    "disclaimer",
    "reproducibility",
    "coverage"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^sx-[a-z0-9-]{1,40}$",
      "description": "Stable pack id, never reused. (HOSTED-PROFILE §5.3 writes this key as `pack:`; the contract name is `id`, matching `run.hosted.packs[].id`.)"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})$",
      "description": "SemVer: a new clause mapping or rule = MINOR; a changed condition = MAJOR."
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "clause_map",
          "scenario_variant",
          "adversarial_peer"
        ]
      }
    },
    "title": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f]*$"
    },
    "licence": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,39}$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builds",
        "versions",
        "contracts"
      ],
      "description": "The engine build range the pack is valid for.",
      "properties": {
        "builds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "description": "The exact engine build hashes the fixtures were run on. The runner refuses every other build (`pack_engine_mismatch`)."
        },
        "versions": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[<>=^~ 0-9A-Za-z@.+-]{1,64}$",
          "description": "engine.version range, for discovery only (e.g. \">=arena@2.1.0 <arena@3.0.0\"). `builds` is what is enforced."
        },
        "contracts": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[\\^~>=< 0-9.]{1,32}$",
          "description": "Contracts range the pack targets (e.g. ^2.2.0)."
        }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "ref",
        "lenses"
      ],
      "description": "The clause corpus snapshot (`sixi-ai/sixi-assure-rules`).",
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,39}/[a-z0-9._-]{1,100}$"
        },
        "ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "The corpus commit every clause id resolves against."
        },
        "lenses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "atlas"
          ],
          "properties": {
            "atlas": {
              "type": "string",
              "pattern": "^v[0-9]{4}\\.[0-9]{2}$"
            }
          }
        }
      }
    },
    "regimes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "OWASP",
          "AIACT"
        ]
      },
      "description": "The regimes the pack cites. Closed set for this contract release: ATLAS is a lens, not a regime (HOSTED-PROFILE §5.4, Q1). Every clause id's regime MUST be listed here (load rule)."
    },
    "disclaimer": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,39}$",
      "description": "Key in corpus/disclaimers.json."
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "count_basis",
        "show_distinct_trajectories"
      ],
      "description": "The pack-wide reproducibility statement (HOSTED-PROFILE §5.5); scenarios set their own `trials`.",
      "properties": {
        "method": {
          "const": "reproduced_n_of_m"
        },
        "count_basis": {
          "const": "assessed_episodes",
          "description": "M counts only episodes where the oracle was assessed; not_assessed episodes go to the not-assessed list."
        },
        "show_distinct_trajectories": {
          "const": true
        }
      }
    },
    "scenarios": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scenario_version",
          "seat_modes",
          "tiers",
          "reproducibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9_]{0,39})$",
            "description": "A variant: a new `sx_` scenario id (never reused), data over `base`. An overlay: an open scenario id, with `peers` seated in it and no `base` or `data`."
          },
          "base": {
            "type": "string",
            "pattern": "^(?!shared$|harness$|sx_)[a-z][a-z0-9_]{0,39}$",
            "description": "Variant only: the open scenario module the variant parameterises (same engine build; a variant needing new engine code is not a pack)."
          },
          "scenario_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})$"
          },
          "seat_modes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "duel",
                "member",
                "squad",
                "power"
              ]
            }
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "edge",
                "core",
                "frontier"
              ]
            }
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "digest"
            ],
            "description": "Variant only: the parameter and template data file, pinned by digest.",
            "properties": {
              "ref": {
                "type": "string",
                "maxLength": 160,
                "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_./-]{0,159}$",
                "description": "A path relative to the pack root; no `..` sequence, no leading `/`."
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "peers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "seat",
                "driver",
                "inputs_source",
                "agent",
                "model",
                "prompt_digest",
                "max_output_tokens"
              ],
              "description": "An LLM-driven adversarial peer (pack kind adversarial_peer). Runs outside the engine image, in the Sixi peer gateway (HOSTED-PROFILE §5.2, §6.1).",
              "properties": {
                "seat": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,31}$",
                  "description": "Which reference seat the peer replaces: a role of the base scenario's roster (e.g. `schemer`, `injector`) or a power."
                },
                "driver": {
                  "const": "recorded_peer"
                },
                "inputs_source": {
                  "const": "llm_peer",
                  "description": "K7: the peer's moves are recorded inputs; `verify` never regenerates them (ADR-004)."
                },
                "agent": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}/[a-z0-9][a-z0-9-]{0,39}@[0-9A-Za-z.+-]{1,32}$"
                },
                "model": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "provider",
                    "model",
                    "region"
                  ],
                  "description": "The model endpoint the Sixi peer gateway calls (through the residency chokepoint). The provider key is never in a pack.",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                    },
                    "model": {
                      "type": "string",
                      "maxLength": 96,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}$"
                    },
                    "region": {
                      "type": "string",
                      "pattern": "^[a-z]{2,12}-[a-z]{2,12}[0-9]{1,2}$"
                    }
                  }
                },
                "prompt_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "description": "Digest of the sealed prompt template; the template itself stays in the gateway."
                },
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                }
              }
            }
          },
          "reproducibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "trials"
            ],
            "description": "How this scenario's findings state reproducibility.",
            "properties": {
              "method": {
                "const": "reproduced_n_of_m",
                "description": "Findings are reported as \"reproduced N of M\" (HOSTED-PROFILE §5.5): M = episodes where the oracle was assessed (pass or fail) for the seat, N = those where the rule held; not_assessed episodes are never counted in M; the number of distinct trajectories is always shown next to it."
              },
              "trials": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Repeats of each seed with the peer re-sampled (M for LLM-peer findings). 0 = reproduction not measured (run-level oracles, deterministic scenarios without peers)."
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^sx_"
                }
              }
            },
            "then": {
              "required": [
                "base",
                "data"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^sx_[a-z0-9_]{1,36}$"
                },
                "base": true,
                "data": true
              }
            },
            "else": {
              "required": [
                "peers"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(?!shared$|harness$|sx_)[a-z][a-z0-9_]{0,39}$"
                },
                "peers": true
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "base"
                    ],
                    "properties": {
                      "base": true
                    }
                  },
                  {
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": true
                    }
                  }
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "peers"
              ],
              "properties": {
                "peers": true
              }
            },
            "then": {
              "properties": {
                "reproducibility": {
                  "type": "object",
                  "properties": {
                    "trials": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "oracles": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "oracle_id",
          "clauses"
        ],
        "description": "clause_map: which clauses an open oracle bears on. The evidence builder applies it outside the engine; it never changes a verdict, a SARIF level or a rule id.",
        "properties": {
          "oracle_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,39}\\.[a-z][a-z0-9_]{0,47}$",
            "description": "An oracle id = SARIF rule id (`<open scenario>.<oracle>`, `shared.<oracle>`, `harness.<oracle>`). Pack scenarios reuse the base scenario's oracle ids; a pack never mints a rule id."
          },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^(OWASP:(AgenticTop10:ASI(0[1-9]|10)|LLMTop10:LLM(0[1-9]|10)|[A-Za-z][A-Za-z0-9]{1,31}:[A-Za-z0-9().-]{1,32})|AIACT:2024/1689:(Art[0-9]{1,3}(\\([0-9]{1,2}\\))?(\\([a-z]\\))?|Annex[IVX]{1,4}(\\([0-9]{1,2}\\))?))$",
              "description": "A clause id in the `sixi-assure-rules` corpus format REGIME:DOC:REF, e.g. `OWASP:AgenticTop10:ASI01`, `OWASP:LLMTop10:LLM01`, `AIACT:2024/1689:Art15(4)`. Only the regimes this contract release knows (OWASP, AIACT) match; `OWASP-AGENTIC:…` and `ATLAS:…` are not regime ids and are rejected. Adding a regime is a contract MINOR. The pack load additionally resolves every id against the corpus snapshot `corpus.ref`; an id that does not resolve fails the load (it is never shown as \"no clause found\")."
            }
          },
          "techniques": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AML\\.T[0-9]{4}(\\.[0-9]{3})?$",
              "description": "A MITRE ATLAS technique id, used as a lens label only (never a clause citation, never the source of a finding)."
            }
          }
        }
      },
      "description": "clause_map: open oracle id -> clause citations and ATLAS technique labels."
    },
    "rules": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "scope",
          "oracles",
          "condition",
          "severity",
          "message",
          "clauses",
          "remediation",
          "fixtures"
        ],
        "description": "A finding rule. Findings come only from rules.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SX[A-Z]-[A-Z]{2,6}-[0-9]{3}$",
            "description": "Stable finding-rule id, never reused (e.g. SXA-BYZ-001)."
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001f]*$"
          },
          "scope": {
            "enum": [
              "verdict",
              "episode",
              "run"
            ]
          },
          "oracles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,39}\\.[a-z][a-z0-9_]{0,47}$",
              "description": "An oracle id = SARIF rule id (`<open scenario>.<oracle>`, `shared.<oracle>`, `harness.<oracle>`). Pack scenarios reuse the base scenario's oracle ids; a pack never mints a rule id."
            },
            "description": "Every oracle id the condition reads (declared so coverage and the not-assessed list can be computed without parsing CEL)."
          },
          "condition": {
            "type": "string",
            "maxLength": 2048,
            "description": "A CEL expression over the typed Report model (variables r, e, v and the count helpers). Closed environment, cost- and time-limited. No model and no heuristic creates a finding."
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "description": "Evidence-view severity only; never changes a SARIF level."
          },
          "message": {
            "type": "string",
            "maxLength": 280,
            "pattern": "^[^\\u0000-\\u001f]*$",
            "description": "Template over ids and counts only ({{v.oracle_id}}, {{n}}, {{m}}, {{v.seat}}); never target or peer text."
          },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^(OWASP:(AgenticTop10:ASI(0[1-9]|10)|LLMTop10:LLM(0[1-9]|10)|[A-Za-z][A-Za-z0-9]{1,31}:[A-Za-z0-9().-]{1,32})|AIACT:2024/1689:(Art[0-9]{1,3}(\\([0-9]{1,2}\\))?(\\([a-z]\\))?|Annex[IVX]{1,4}(\\([0-9]{1,2}\\))?))$",
              "description": "A clause id in the `sixi-assure-rules` corpus format REGIME:DOC:REF, e.g. `OWASP:AgenticTop10:ASI01`, `OWASP:LLMTop10:LLM01`, `AIACT:2024/1689:Art15(4)`. Only the regimes this contract release knows (OWASP, AIACT) match; `OWASP-AGENTIC:…` and `ATLAS:…` are not regime ids and are rejected. Adding a regime is a contract MINOR. The pack load additionally resolves every id against the corpus snapshot `corpus.ref`; an id that does not resolve fails the load (it is never shown as \"no clause found\")."
            }
          },
          "techniques": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AML\\.T[0-9]{4}(\\.[0-9]{3})?$",
              "description": "A MITRE ATLAS technique id, used as a lens label only (never a clause citation, never the source of a finding)."
            },
            "description": "ATLAS technique labels (lens). HOSTED-PROFILE §5.3 writes these as `lenses: {atlas: [...]}`; the contract name is `techniques[]`."
          },
          "remediation": {
            "type": "string",
            "maxLength": 400,
            "pattern": "^[^\\u0000-\\u001f]*$"
          },
          "fixtures": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "positive",
              "negative"
            ],
            "description": "Both are required; the pack eval must show the positive fixture fires and the negative does not.",
            "properties": {
              "positive": {
                "type": "string",
                "maxLength": 160,
                "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_./-]{0,159}$",
                "description": "A path relative to the pack root; no `..` sequence, no leading `/`."
              },
              "negative": {
                "type": "string",
                "maxLength": 160,
                "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_./-]{0,159}$",
                "description": "A path relative to the pack root; no `..` sequence, no leading `/`."
              }
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clauses"
      ],
      "description": "The clauses the pack claims to bear on. Feeds the not-assessed enumeration: a clause here that no assessed oracle of a run maps to is listed as not assessed (Report `not_assessed`, kind clause). (2.9.0, load rule; signing.md §11.3 step 6a) Coverage includes the clause map: `coverage.clauses` MUST contain every clause id that `oracles[].clauses` or `rules[].clauses` cites (coverage ⊇ clause map ∪ rule clauses). A pack that cites a clause outside its coverage is refused (`scenario_pack_unavailable`), because the not-assessed enumeration walks `coverage.clauses`: a mapped clause missing there would never be listed as not assessed when its oracles were not assessed. The reverse is not required: coverage MAY list a clause no oracle maps, and such a clause is always listed as not assessed (`clause_not_mapped_in_run`), never as assessed. JSON Schema cannot state inclusion between two arrays, so the rule is enforced by the pack eval, the hosted runner's pack load and the evidence builder, and `tools/contract-check.mjs` checks it on every pack example.",
      "properties": {
        "clauses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^(OWASP:(AgenticTop10:ASI(0[1-9]|10)|LLMTop10:LLM(0[1-9]|10)|[A-Za-z][A-Za-z0-9]{1,31}:[A-Za-z0-9().-]{1,32})|AIACT:2024/1689:(Art[0-9]{1,3}(\\([0-9]{1,2}\\))?(\\([a-z]\\))?|Annex[IVX]{1,4}(\\([0-9]{1,2}\\))?))$",
            "description": "A clause id in the `sixi-assure-rules` corpus format REGIME:DOC:REF, e.g. `OWASP:AgenticTop10:ASI01`, `OWASP:LLMTop10:LLM01`, `AIACT:2024/1689:Art15(4)`. Only the regimes this contract release knows (OWASP, AIACT) match; `OWASP-AGENTIC:…` and `ATLAS:…` are not regime ids and are rejected. Adding a regime is a contract MINOR. The pack load additionally resolves every id against the corpus snapshot `corpus.ref`; an id that does not resolve fails the load (it is never shown as \"no clause found\")."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kinds": {
            "type": "array",
            "contains": {
              "const": "clause_map"
            }
          }
        }
      },
      "then": {
        "required": [
          "oracles",
          "rules"
        ],
        "properties": {
          "oracles": {
            "type": "array",
            "minItems": 1
          },
          "rules": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kinds": {
            "type": "array",
            "contains": {
              "const": "scenario_variant"
            }
          }
        }
      },
      "then": {
        "required": [
          "scenarios"
        ],
        "properties": {
          "scenarios": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "base"
              ],
