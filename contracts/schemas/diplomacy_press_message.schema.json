                "respond_to": {
                  "not": {
                    "type": "string",
                    "pattern": ":r[1-3]:turkey:"
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "move"
              ],
              "properties": {
                "move": {
                  "const": "withdraw"
                }
              }
            },
            "then": {
              "properties": {
                "respond_to": {
                  "type": "string",
                  "pattern": ":r[1-3]:turkey:"
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "power": {
      "enum": [
        "austria",
        "england",
        "france",
        "germany",
        "italy",
        "russia",
        "turkey"
      ],
      "description": "A standard-map power. Lower-case full names, the same tokens as the order grammar (diplomacy-adjudicator.md §1.1). Canonical order everywhere: alphabetical, as listed."
    },
    "province": {
      "enum": [
        "adr",
        "aeg",
        "alb",
        "ank",
        "apu",
        "arm",
        "bal",
        "bar",
        "bel",
        "ber",
        "bla",
        "boh",
        "bot",
        "bre",
        "bud",
        "bul",
        "bur",
        "cly",
        "con",
        "den",
        "eas",
        "edi",
        "eng",
        "fin",
        "gal",
        "gas",
        "gre",
        "hel",
        "hol",
        "ion",
        "iri",
        "kie",
        "lon",
        "lvn",
        "lvp",
        "lyo",
        "mao",
        "mar",
        "mos",
        "mun",
        "naf",
        "nao",
        "nap",
        "nth",
        "nwg",
        "nwy",
        "par",
        "pic",
        "pie",
        "por",
        "pru",
        "rom",
        "ruh",
        "rum",
        "ser",
        "sev",
        "sil",
        "ska",
        "smy",
        "spa",
        "stp",
        "swe",
        "syr",
        "tri",
        "tun",
        "tus",
        "tyr",
        "tys",
        "ukr",
        "ven",
        "vie",
        "wal",
        "war",
        "wes",
        "yor"
      ],
      "description": "One of the 75 standard-map province ids (diplomacy-adjudicator.md §1.2)."
    },
    "movement_phase": {
      "type": "string",
      "maxLength": 6,
      "pattern": "^[SF]190[1-8]M$",
      "description": "A movement phase id, e.g. S1902M. Years 1901..1908 (the longest horizon)."
    },
    "msg_id": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^prs:[SF]190[1-8]M:r[1-3]:(austria|england|france|germany|italy|russia|turkey):([1-9]|1[0-2])$",
      "description": "Engine-assigned press message id `prs:<movement phase>:r<round>:<sender power>:<seq>`, seq = 1-based position in the sender's batch for that round. Never agent-chosen; deterministic, so an agent can predict its own ids (the offer signature covers the expected id)."
    },
    "order_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "One order in the canonical text grammar (diplomacy-adjudicator.md §1.5.1: ASCII, case-sensitive, single spaces, <= 64 chars), e.g. `A ruh - bel`, `A hol S A ruh - bel`, `F nth C A yor - nwy`, `A lvp - edi VIA`, `F kie D`, `B F stp/nc`, `W`. Province ids are lower case, keywords upper case. The schema bounds only the length; syntax is checked by the adjudicator's parser, per order, and a bad order is reported in `order_feedback` (it never rejects the frame)."
    },
    "clause": {
      "description": "One machine-checkable obligation about future orders (diplomacy-scenario.md §1.5). The obligor is the party whose side (`give` or `want`) holds the clause. Judged on SUBMITTED orders, never on the adjudicated outcome (a cut support is kept). A clause that is impossible at its phase (unit gone, order illegal at phase start) settles `void`. Spans cover movement phases only, from_phase <= to_phase, with to_phase at most 4 movement phases after from_phase, so one clause covers at most 5 [DIAL] (engine-checked: terms_invalid). (2.5.0) No clause may cover a phase after the game's final movement phase F<final_year>M (observation `horizon.final_year`): the engine refuses it `clause_beyond_horizon` (wot-dip-scenario/2 onward); a phase after 1908 already fails this schema. There is no free-text clause: a promise written in `body` is never a commitment.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "phase",
            "order"
          ],
          "description": "Kept iff the obligor submitted exactly this order (canonical comparison) for that unit in `phase`. Covers hold, move, support-hold, support-move and convoy promises.",
          "properties": {
            "kind": {
              "const": "order"
            },
            "phase": {
              "$ref": "#/$defs/movement_phase"
            },
            "order": {
              "$ref": "#/$defs/order_text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "from_phase",
            "to_phase",
            "provinces"
          ],
          "description": "DMZ / no-move-into. Kept iff, in every covered phase, no obligor unit was ordered to move into a listed province and no obligor unit supported or convoyed a move into one.",
          "properties": {
            "kind": {
              "const": "no_enter"
            },
            "from_phase": {
              "$ref": "#/$defs/movement_phase"
            },
            "to_phase": {
              "$ref": "#/$defs/movement_phase"
            },
            "provinces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/province"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "from_phase",
            "to_phase",
            "power"
          ],
          "description": "Kept iff no obligor order moved into, supported a move into, or convoyed into a province that at the START of that phase held a unit of `power` or was a supply centre owned by `power`.",
          "properties": {
            "kind": {
              "const": "no_attack"
            },
            "from_phase": {
              "$ref": "#/$defs/movement_phase"
            },
            "to_phase": {
              "$ref": "#/$defs/movement_phase"
            },
            "power": {
              "$ref": "#/$defs/power"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "from_phase",
            "to_phase",
            "power"
          ],
          "description": "Kept iff no obligor support or convoy was for a move into a province that at phase start held a unit of `power`.",
          "properties": {
            "kind": {
              "const": "no_support_against"
            },
            "from_phase": {
              "$ref": "#/$defs/movement_phase"
            },
            "to_phase": {
              "$ref": "#/$defs/movement_phase"
            },
            "power": {
              "$ref": "#/$defs/power"
            }
          }
        }
      ]
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "give",
        "want"
      ],
      "description": "Offer terms: `give` = the proposer's obligations, `want` = the acceptor's. At least one clause in total. Terms are VALIDATED, never rewritten: `terms_hash = sha256(canonical JSON of terms)` (sorted keys, no whitespace) is what the signature covers, so a note that the sanitiser would change is rejected (press_invalid_text), not altered.",
      "properties": {
        "give": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/clause"
          }
        },
        "want": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/clause"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Optional plain-text note, <= 200 bytes UTF-8, single line, already in sanitised form (untrusted; scanned by intent_leak like any press)."
        }
      },
      "anyOf": [
        {
          "properties": {
            "give": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "want": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "recipients": {
      "description": "Who receives the message. The sender is never a recipient of its own message; a group of all six other powers is not a group (use broadcast). Offer moves are always private (an offer is bilateral).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "power"
          ],
          "properties": {
            "kind": {
              "const": "private"
            },
            "power": {
              "$ref": "#/$defs/power"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "powers"
          ],
          "properties": {
            "kind": {
              "const": "group"
            },
            "powers": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/power"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "broadcast"
            }
          }
        }
      ]
    },
    "sig_mode": {
      "enum": [
        "key",
        "session"
      ],
      "description": "key = a detached Ed25519 JWS that verified against the sender's passport signing key (signing.md §7). session = attested only by the authenticated connection: the local CLI runner, or a table session of a development or test deployment; a hosted run or a production table never accepts it. Phase 9 evidence packs require key. A move's mode is its own; a commitment is key only if both its offer and its accept were key."
    },
    "sha256": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
