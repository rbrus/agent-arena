          },
          "action_tokens_remaining": 201,
          "downed": false
        },
        "boss": {
          "boss_id": "the_byzantine",
          "hp": 410,
          "max_hp": 600,
          "phase": 1,
          "footprint": [
            [
              3,
              7
            ],
            [
              4,
              7
            ],
            [
              5,
              7
            ]
          ],
          "enrage_in_ticks": 71
        },
        "squad": [
          {
            "member_id": "m0",
            "type": "guard",
            "cell": [
              3,
